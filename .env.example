# ============================================================================
# SAMU BET — Configurazione Variabili d'Ambiente (.env.example)
# ============================================================================
# ATTENZIONE: Tutte le chiavi API devono restare SOLO nel backend o nel bridge.
# Non inserire mai chiavi segrete nel bundle del frontend (niente prefisso VITE_).
# ============================================================================

# --- 1. MODALITÀ SVILUPPO / PRODUZIONE ---
# Imposta DEMO_MODE=true SOLO in sviluppo locale se non hai ancora inserito le chiavi API.
# In produzione (NODE_ENV=production) DEMO_MODE viene forzatamente ignorato e disabilitato.
NODE_ENV=development
PORT=3001
DEMO_MODE=false

# --- 2. QUOTE (OddsProvider Primario: The Odds API) ---
# Registrazione gratuita (500 crediti/mese, nessuna carta richiesta):
# https://the-odds-api.com/
THE_ODDS_API_KEY=
THE_ODDS_API_REGIONS=eu
# Limite massimo di richieste esterne giornaliere globali del backend per proteggere il piano gratuito
DAILY_API_QUOTA_LIMIT=45
# Limite generazioni per singolo IP all'ora (protezione endpoint pubblico senza login)
RATE_LIMIT_PER_IP_HOUR=15

# --- 3. STATISTICHE CALCIO ---
# Fonte primaria consigliata (Piano gratuito: 12 campionati top, 10 req/min):
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Fonte secondaria opzionale (Piano gratuito: 100 req/giorno su api-sports.io):
# https://dashboard.api-football.com/register
API_FOOTBALL_KEY=

# --- 4. STATISTICHE FORMULA 1 ---
# Jolpica-F1 (successore open-source di Ergast) è gratuito e NON richiede chiave API.
JOLPICA_F1_BASE_URL=https://api.jolpi.ca/ergast/f1

# --- 5. FEED RSS NOTIZIE SPORTIVE (Separati da virgola, verificati attivi) ---
RSS_FEEDS_FOOTBALL=https://www.gazzetta.it/dynamic-feed/rss/section/Calcio.xml,https://feeds.bbci.co.uk/sport/football/rss.xml
RSS_FEEDS_F1=https://www.gazzetta.it/dynamic-feed/rss/section/Formula-1.xml,https://www.motorsport.com/rss/f1/news/,https://www.formulapassion.it/feed,https://feeds.bbci.co.uk/sport/formula1/rss.xml
RSS_FEEDS_TENNIS=https://www.gazzetta.it/dynamic-feed/rss/section/Tennis.xml,https://www.ubitennis.com/feed/,https://feeds.bbci.co.uk/sport/tennis/rss.xml,https://www.oasport.it/feed/

# --- 6. AI OPZIONALE LATO SERVER (Disattivata di default) ---
# Non necessaria: SAMU BET usa di default il modello locale tramite local-ai-bridge.
GEMINI_API_KEY=

# ============================================================================
# CONFIGURAZIONE PER /local-ai-bridge (Da eseguire sul PC Windows dell'utente)
# ============================================================================
# Endpoint locale di Unsloth (MAI esporre Unsloth su 0.0.0.0, usare sempre 127.0.0.1)
LLM_BASE_URL=http://127.0.0.1:8888/v1
# API Key stampata in console da Unsloth all'avvio (es. sk-unsloth-...)
LLM_API_KEY=sk-unsloth-inserisci-qui
# Modello GGUF predefinito (3-4B Q4 per CPU 16GB RAM; opzione 7-8B: unsloth/Qwen3-8B-Instruct-GGUF:Q4_K_M)
LLM_MODEL=unsloth/Qwen3-4B-Instruct-GGUF:Q4_K_M
# Token segreto richiesto dal bridge nell'header Authorization: Bearer <BRIDGE_TOKEN>
BRIDGE_TOKEN=genera-un-token-casuale-lungo-almeno-32-caratteri
# Origine autorizzata via CORS (URL dell'app pubblicata su Vercel o http://localhost:5173 in locale)
ALLOWED_ORIGIN=http://localhost:5173
# Porta locale su cui ascolta il local-ai-bridge (127.0.0.1:8787)
BRIDGE_PORT=8787

