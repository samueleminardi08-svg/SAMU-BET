# ============================================================================
# SAMU BET v1.1 — Configurazione Variabili d'Ambiente (.env.example)
# ============================================================================
# ATTENZIONE: Tutte le chiavi API devono restare SOLO nel backend o nel bridge.
# Non inserire mai chiavi segrete nel bundle del frontend (niente prefisso VITE_).
# ============================================================================

# --- 1. MODALITÀ SVILUPPO / PRODUZIONE ---
# Imposta DEMO_MODE=true SOLO in sviluppo locale se non hai ancora inserito le chiavi API.
# In produzione (NODE_ENV=production) DEMO_MODE viene forzatamente ignorato e disabilitato.
NODE_ENV=development
PORT=3001
DEMO_MODE=false

# --- 2. QUOTE & CALENDARIO (The Odds API - Gratuito 500 crediti/mese) ---
# Registrazione gratuita (nessuna carta richiesta): https://the-odds-api.com/
THE_ODDS_API_KEY=
THE_ODDS_API_REGIONS=eu
# Limite massimo di richieste esterne giornaliere globali per proteggere la quota
DAILY_API_QUOTA_LIMIT=45
# Limite generazioni per singolo IP all'ora (protezione endpoint pubblico)
RATE_LIMIT_PER_IP_HOUR=15

# --- 3. CALENDARIO & STATISTICHE CALCIO (Football-Data.org - Gratuito) ---
# Registrazione gratuita (12 campionati top, 10 req/min): https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Fonte secondaria opzionale (Piano gratuito: 100 req/giorno su api-sports.io):
API_FOOTBALL_KEY=

# Ordine di priorità dei provider del calendario partite (separati da virgola):
FIXTURES_PROVIDER_ORDER=the-odds-api,football-data

# OneFootball: Disabilitato per violazione Termini d'Uso (proibisce scraper/bot non autorizzati)
ONEFOOTBALL_ENABLED=false

# --- 4. GOOGLE GEMINI AI (Pipeline a 2 Stadi: Stima + Revisione Qualitativa) ---
# Chiave gratuita Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Modello primario con fallback dinamico (gemini-3.8-flash, gemini-2.5-flash, gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Livello di ragionamento (Thinking Budget):
# - low: rapido ed efficiente per la stima probabilità dei singoli eventi (Stadio A)
# - high: approfondito per la revisione qualitativa d'insieme della schedina (Stadio B)
GEMINI_THINKING_LEVEL_ESTIMATE=low
GEMINI_THINKING_LEVEL_REVIEW=high

# Google Search Grounding:
# NOTA: Il piano free tier di Gemini blocca il tool "googleSearch" con errore 429 RESOURCE_EXHAUSTED.
# Abilitare (true) solo se il progetto Google Cloud è collegato a un piano con fatturazione.
GROUNDING_ENABLED=false
GROUNDING_MONTHLY_BUDGET=4000

# --- 5. VINCOLI DI VARIETÀ E DIVERSIFICAZIONE MERCATI ---
# Ripiego deterministico sul limite massimo di selezioni con lo stesso mercato quando l'AI non è disponibile
MAX_SAME_MARKET_SELECTION=3
# Limite rigido massimo consigliabile (default max(2, ceil(N/2)))
DIVERSITY_HARD_MAX=3

# --- 6. STATISTICHE FORMULA 1 & TENNIS ---
# Jolpica-F1 (successore open-source di Ergast) è gratuito e NON richiede chiave API.
JOLPICA_F1_BASE_URL=https://api.jolpi.ca/ergast/f1

# --- 7. FEED RSS NOTIZIE SPORTIVE (Separati da virgola) ---
RSS_FEEDS_FOOTBALL=https://www.gazzetta.it/dynamic-feed/rss/section/Calcio.xml,https://feeds.bbci.co.uk/sport/football/rss.xml
RSS_FEEDS_F1=https://www.gazzetta.it/dynamic-feed/rss/section/Formula-1.xml,https://www.motorsport.com/rss/f1/news/,https://www.formulapassion.it/feed,https://feeds.bbci.co.uk/sport/formula1/rss.xml
RSS_FEEDS_TENNIS=https://www.gazzetta.it/dynamic-feed/rss/section/Tennis.xml,https://www.ubitennis.com/feed/,https://feeds.bbci.co.uk/sport/tennis/rss.xml,https://www.oasport.it/feed/

# ============================================================================
# CONFIGURAZIONE PER /local-ai-bridge (Bridge Locale Opzionale)
# ============================================================================
LLM_BASE_URL=http://127.0.0.1:8888/v1
LLM_API_KEY=sk-unsloth-inserisci-qui
LLM_MODEL=unsloth/Qwen3-4B-Instruct-GGUF:Q4_K_M
BRIDGE_TOKEN=genera-un-token-casuale-lungo-almeno-32-caratteri
ALLOWED_ORIGIN=http://localhost:5173
BRIDGE_PORT=8787
